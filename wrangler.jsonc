{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aura",
    "compatibility_date": "2026-09-23",
    "workers_dev": false,
    "preview_urls": false,
    "assets": {
        "directory": "./dist",
    },
    "env": {
        "preview": {
            "name": "aura-preview",
        },
        "production": {
            "name": "aura",
        },
    },
}
