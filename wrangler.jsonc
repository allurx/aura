{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aura",
    "compatibility_date": "2026-09-23",
    "workers_dev": false,
    "preview_urls": false,
    "dev": {
        "port": 4173,
    },
    "assets": {
        "directory": "./dist/web-obfuscated",
    },
    "routes": [
        {
            "pattern": "aura.allurx.io",
            "zone_name": "allurx.io",
            "custom_domain": true,
        },
    ],
}
