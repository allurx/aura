{
    "name": "aura",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.21.0"
    },
    "scripts": {
        "dev": "vite --open --host 0.0.0.0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "test": "vite build && vite build --mode portable && node --test --test-concurrency=2 tests/*.test.ts",
        "verify": "npm run check && npm test",
        "build": "npm run check && vite build",
        "build:portable": "npm run check && vite build --mode portable",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@allurx/js-config": "1.0.1",
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "jiti": "2.7.0",
        "playwright-core": "1.64.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vite-plugin-singlefile": "2.3.3",
        "wrangler": "4.149.0"
    },
    "prettier": "@allurx/js-config/prettier",
    "dependencies": {
        "chardet": "2.2.0",
        "fflate": "0.8.3"
    }
}
