{
    "name": "aura",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "build": "npm run lint && npm run type-check && vite build",
        "dev": "npm run lint && npm run type-check && vite --open page/bookshelf/bookshelf.html",
        "preview": "npm run build && vite preview --open page/bookshelf/bookshelf.html"
    },
    "devDependencies": {
        "@types/node": "^24.9.2",
        "prettier": "3.6.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.2",
        "vite": "7.1.12",
        "vite-plugin-html": "3.2.2",
        "vite-plugin-javascript-obfuscator": "3.1.0"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "es5"
    }
}
