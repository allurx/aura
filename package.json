{
    "name": "aura",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite --open",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src vite.config.ts",
        "type-check": "tsc --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "verify": "npm run check && vite build && vite build --mode portable",
        "build": "npm run check && vite build",
        "build:portable": "npm run check && vite build --mode portable",
        "build:obfuscated": "npm run check && vite build --mode obfuscated",
        "build:portable:obfuscated": "npm run check && vite build --mode portable-obfuscated",
        "preview": "vite preview --open"
    },
    "devDependencies": {
        "@eslint/js": "9.38.0",
        "@types/node": "^24.9.2",
        "eslint": "9.38.0",
        "prettier": "3.6.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.2",
        "vite": "7.3.6",
        "vite-plugin-javascript-obfuscator": "3.1.0",
        "vite-plugin-singlefile": "^2.3.3"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": true,
        "singleQuote": false,
        "endOfLine": "lf",
        "embeddedLanguageFormatting": "auto",
        "trailingComma": "es5"
    },
    "dependencies": {
        "chardet": "2.2.0"
    }
}
